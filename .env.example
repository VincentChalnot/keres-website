# Development environment for compose.yaml.
# Copy to .env and adjust. Never commit .env.
#
#   cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────

# Bare dev domain. DNS must resolve to 127.0.0.1; the external Traefik
# instance must be able to obtain a TLS cert for it. The platform origin
# (app.${SERVER_NAME}) used by "Play now"/login/contact links is derived
# from this same value at Hugo build time — see
# layouts/partials/platform-url.html. Run keres-platform's compose.yaml
# with the same SERVER_NAME to exercise those links against a real backend.
SERVER_NAME=local.playkeres.com

# ── Traefik / reverse proxy ──────────────────────────────────────────────

# Name of the external docker network the shared Traefik instance listens on.
# TRAEFIK_NETWORK=proxy

# Entrypoint name configured on the external Traefik instance for TLS traffic.
# TRAEFIK_ENTRYPOINT=websecure

# Cert resolver configured on the external Traefik instance.
# CERT_RESOLVER=infomaniak
